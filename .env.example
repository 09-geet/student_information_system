# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=student_db

# Session (use a long random string — change this!)
SESSION_SECRET=change_this_to_a_long_random_secret_string_at_least_32_chars
